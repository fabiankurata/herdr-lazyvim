#!/usr/bin/env python3
"""Create synthetic repos only inside the caller's explicit isolated runtime."""
import os
from pathlib import Path
import subprocess
import sys


def create(destination):
    root = destination.parent
    if root.parent != Path('/tmp') or not root.name.startswith('hf-') or root.is_symlink():
        raise ValueError('fixture destination must be a direct child of an owned /tmp/hf-* root')
    expected = {'HOME': 'home', 'XDG_CONFIG_HOME': 'config', 'XDG_CACHE_HOME': 'cache',
                'XDG_DATA_HOME': 'data', 'XDG_STATE_HOME': 'state', 'XDG_RUNTIME_DIR': 'runtime',
                'XDG_CONFIG_DIRS': 'config-dirs', 'XDG_DATA_DIRS': 'data-dirs'}
    for key, directory in expected.items():
        if os.environ.get(key) != str(root / directory):
            raise ValueError('fixture requires the owned isolated environment: ' + key)
    if destination.name in ('.', '..'):
        raise ValueError('invalid fixture name')
    linked = root / (destination.name + '-linked-worktree')
    ordinary = root / (destination.name + '-non-git')
    for path in (destination, linked, ordinary):
        if path.exists() or path.is_symlink():
            raise FileExistsError('fixture path already exists: ' + str(path))
    destination.mkdir()
    def git(*args):
        subprocess.run(['git', '-C', str(destination), *args], check=True, timeout=5)
    git('init', '-q')
    git('config', 'user.email', 'fixture@example.invalid')
    git('config', 'user.name', 'Herdr fixture')
    files = {
        'src/index.ts': 'export const greeting: string = "fixture";\n',
        'web/App.vue': '<template><main>fixture</main></template>\n<script setup lang="ts">const ready = true</script>\n',
        'src/main.go': 'package main\nfunc main() {}\n',
        'src/main.rs': 'fn main() { println!("fixture"); }\n',
        'infra/main.tf': 'terraform { required_version = ">= 1.0" }\n',
        'docs/notes.txt': 'ordinary synthetic text\n',
        'path with spaces/file.txt': 'space path fixture\n',
    }
    for name, content in files.items():
        path = destination / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
    git('add', '.')
    git('commit', '-qm', 'fixture-initial')
    git('branch', 'fixture-history')
    with (destination / 'src/index.ts').open('a') as stream:
        stream.write('export const revision = 2;\n')
    git('add', 'src/index.ts')
    git('commit', '-qm', 'fixture-second')
    git('worktree', 'add', '-q', str(linked), 'fixture-history')
    ordinary.mkdir()
    (ordinary / 'plain.txt').write_text('not a repository\n')


if __name__ == '__main__':
    try:
        if len(sys.argv) != 2:
            raise ValueError('usage: tests/fixtures/create DESTINATION')
        create(Path(sys.argv[1]))
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
